APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
# database (not sync): verification/reset emails are dispatched via
# ->queue() (GlobalFunction::issueVerificationCode) so a slow SMTP handshake
# can never block the registerUser/forgotPassword HTTP response. Requires
# the jobs table (php artisan queue:table && migrate) and a worker actually
# processing it, e.g. a cron entry: * * * * * php artisan queue:work --stop-when-empty --max-time=50
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password reset and email verification both send real mail through this.
# Leaving it pointed at mailhog makes user/forgotPassword fail at runtime with
# "Could not send the email, please try again later". Production uses the
# cPanel mailbox on the app domain.
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"
# Hard cap (seconds) on the SMTP connection so a stalled mail host can never
# stall a request for longer than this (config/mail.php mailers.smtp.timeout).
MAIL_TIMEOUT=8
# Set false to disable the emailed verification/reset codes entirely; the
# endpoints then fail fast with a clear message instead of attempting SMTP.
EMAIL_VERIFICATION_ENABLED=true

# Base FCM topic for admin broadcast notifications. The app subscribes to
# "<topic>_android" / "<topic>_ios" and this MUST match notificationTopic in
# lib/utilities/const_res.dart. Defaulted in config/services.php, so an unset
# value no longer broadcasts to the dead topic "_android".
NOTIFICATION_TOPIC=silitibum

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Read directly by GlobalFunction::getItemBaseUrl/generateFileUrl (not by
# Laravel's Storage::url()) when FILES_STORAGE_LOCATION=AWSS3. Must be a
# CloudFront distribution domain fronting the bucket (e.g.
# "https://dxxxxxxxxxxxxx.cloudfront.net/"), NOT the raw S3 bucket URL —
# pointing this at the raw bucket URL skips the CDN entirely while still
# "working", the same footgun documented below for DO_SPACE_URL.
AWS_ITEM_BASE_URL=

# Where uploaded post/story/profile media is stored — read by
# GlobalFunction::saveFile/deleteFile/getItemBaseUrl (app/Models/GlobalFunction.php).
# One of: AWSS3, DOSPACE, PUBLIC. PUBLIC serves files straight off this
# server's disk with no CDN — fine for local dev, not for production.
FILES_STORAGE_LOCATION=DOSPACE

# DigitalOcean Spaces (config/filesystems.php 'digitalocean' disk). Region
# and endpoint must match where you created the Space, e.g. region "nyc3",
# endpoint "https://nyc3.digitaloceanspaces.com".
DO_SPACE_ACCESS_KEY_ID=
DO_SPACE_SECRET_ACCESS_KEY=
DO_SPACE_REGION=
DO_SPACE_BUCKET=
DO_SPACE_ENDPOINT=
# IMPORTANT: use the Space's CDN endpoint here (the one ending in
# .cdn.digitaloceanspaces.com from the "Enable CDN" toggle in the DO
# dashboard), NOT the raw origin URL — pointing this at the origin URL
# instead silently skips the CDN entirely while still "working".
DO_SPACE_URL=

# Static ffmpeg binary used by App\Jobs\TranscodeVideoJob to build
# adaptive-bitrate HLS renditions for reels/feed videos. Defaults to
# storage_path('app/bin/ffmpeg') if unset — only set this if you installed it
# somewhere else. On shared hosting without a package manager, a static build
# from https://johnvansickle.com/ffmpeg/ works (verify `disable_functions` in
# `php -i` doesn't block exec/shell_exec first — TranscodeVideoJob shells out
# to run it).
FFMPEG_BINARY_PATH=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Required for social login (see GlobalFunction::verifyGoogleIdToken /
# verifyAppleIdentityToken). If unset, Google login is refused outright and
# Apple login always fails — both fail closed, never silently unverified.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=

# RevenueCat — coin purchase verification (WalletController::buyCoins) and
# subscription state sync (RevenueCatWebhookController). RC_KIT_API_KEY is a
# secret API key from RevenueCat's dashboard (Project Settings > API Keys),
# RC_PROJECT_ID is your RevenueCat project id. REVENUECAT_WEBHOOK_SECRET is a
# string YOU make up and paste into RevenueCat's dashboard under
# Integrations > Webhooks as the "Authorization header value" — RevenueCat
# echoes it back on every webhook call, and that's the entire authenticity
# check (a static shared secret, not HMAC signing).
RC_KIT_API_KEY=
RC_PROJECT_ID=
REVENUECAT_WEBHOOK_SECRET=
